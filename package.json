{
  "name": "focms-sas-election-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend && eslint backend --config eslint.config.js",
    "test": "npm run test --workspace backend",
    "preview": "npm run preview --workspace frontend",
    "start": "npm run start --workspace backend",
    "create-admin": "npm run create-admin --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
